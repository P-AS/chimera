<?xml version="1.0" encoding="utf-8"?>
<!-- Mono reads this; on macOS the X11 libraries (an X server's clients: XQuartz, Xwayland) go by their macOS names -->
<configuration>
	<dllmap dll="libX11.so.6" target="libX11.6.dylib" os="osx" />
	<dllmap dll="libXfixes.so.3" target="libXfixes.3.dylib" os="osx" />
	<dllmap dll="libXi.so.6" target="libXi.6.dylib" os="osx" />
</configuration>
